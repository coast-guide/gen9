# gen9-edge's sites: one host per service people reach, all under GEN9_DOMAIN (README). Each goes
# to the name its stack gives on its own network; Caddy keeps the Host header, which Langfuse's
# media store signs, and passes event streams on unbuffered.

# The certificate: `internal`, Caddy's own CA, for a machine with no public name; or an email,
# for one from Let's Encrypt (ACME)
(certificate) {
	tls {$GEN9_EDGE_TLS:internal}
}

{$GEN9_DOMAIN} {
	import certificate
	reverse_proxy gen9-ui:3000
}

id.{$GEN9_DOMAIN} {
	import certificate
	reverse_proxy gen9-keycloak:8080
}

api.{$GEN9_DOMAIN} {
	import certificate
	reverse_proxy gen9-agent:8000
}

traces.{$GEN9_DOMAIN} {
	import certificate
	reverse_proxy gen9-langfuse:3000
}

traces-media.{$GEN9_DOMAIN} {
	import certificate
	reverse_proxy gen9-langfuse-media:9000
}

temporal.{$GEN9_DOMAIN} {
	import certificate
	reverse_proxy gen9-temporal-ui:8080
}

# The connector apps' views, one host per connector, so none shares another's origin. A wildcard:
# Let's Encrypt issues one only by DNS challenge, so with ACME give a certificate of your own
# (GEN9_EDGE_APPS_TLS: "<cert file> <key file>" under /certs)
*.apps.{$GEN9_DOMAIN} {
	tls {$GEN9_EDGE_APPS_TLS:internal}
	reverse_proxy gen9-ui-apps:3001
}
