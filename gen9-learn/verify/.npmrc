# A dependency cooldown: the versions npm install or npm update chooses must have been published 7
# days before, so a malicious release has had time to be found and pulled before it can come in
# (docs/development.md, "Dependencies"). npm ci installs the lockfile as it is. npm 11.10 and later;
# an older npm warns "Unknown project config" and goes on without it. One package that must come
# in sooner: min-release-age-exclude
min-release-age=7

# Dependencies' install scripts (preinstall, install, postinstall) run only when package.json's
# allowScripts says so, and one nobody has reviewed fails the install (OWASP A03: the Shai-Hulud
# worm spread through them). Review with `npm install-scripts ls`, then approve or deny
# (docs/development.md, "Dependencies"). npm 11.19 and later; npm 12 denies them by default
strict-allow-scripts=true
