{
  "name": "gen9-keycloak-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Gen9 login theme for Keycloak (Keycloakify), built from the gen9-design system",
  "type": "module",
  "scripts": {
    "postinstall": "keycloakify sync-extensions",
    "dev": "vite",
    "build": "tsc && vite build",
    "build-keycloak-theme": "npm run build && keycloakify build"
  },
  "dependencies": {
    "keycloakify": "11.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@keycloakify/email-native": "~260007.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild": false
  }
}
