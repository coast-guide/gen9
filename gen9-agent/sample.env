# Copy to .env and fill in. Database, Keycloak and model router settings come from the generated
# postgres.local.env, keycloak.local.env and models.local.env (see README), not from this file.
# Model providers' keys (OPENAI_API_KEY, …) belong to gen9-models/.env: gen9-agent reaches every
# model through the router and holds no provider key.
# Optional: where agent runs are traced. make setup writes gen9-langfuse's keys to langfuse.local.env,
# which wins over these; set them here only to trace to another Langfuse.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:13000

# How often (seconds) the Temporal Schedule removes Gen9 data of users deleted in Keycloak
# directly; 0 = off
# DELETED_USERS_SWEEP_INTERVAL_S=900

# Keys that encrypt what gen9-agent sends to Temporal (src/gen9_agent/codec.py): "id:base64" pairs
# of 32-byte keys, comma-separated; the first encrypts, all decrypt. make setup generates one.
# To rotate: put a new key first and keep the old ones until nothing written with them is left.
TEMPORAL_PAYLOAD_KEYS=

# Keys that seal secrets people give Gen9, such as a connector's token (src/gen9_agent/vault.py):
# "id:base64" pairs of 32-byte keys, comma-separated; the first seals, all open. make setup generates
# one. To rotate: put a new key first and keep the old ones until nothing sealed with them is left.
GEN9_SECRET_KEYS=

# Connectors reach only public https servers; true also allows http and private addresses (a server
# on your own network). Never on a host other people's connectors share
# CONNECTORS_ALLOW_PRIVATE=false
# Named hosts connectors may reach although private, over http too, as a JSON list of "host" or
# "host:port". make setup adds e2e's test servers (sign-in, asking the person, an app, Keycloak's); leave them out where others'
# connectors run
# CONNECTORS_ALLOWED_HOSTS=["host.docker.internal:17801", "host.docker.internal:17802", "host.docker.internal:17803", "host.docker.internal:17804", "host.docker.internal:15000"]
# Plugin sources (git repositories with a plugin marketplace, added by admins) are fetched over
# https from public hosts only; named hosts may be private and use http, as a JSON list of "host" or
# "host:port". make setup adds e2e's git server; leave it out where others add sources
# PLUGIN_SOURCES_ALLOWED_HOSTS=["host.docker.internal:17805"]
# How often every source syncs, in seconds (a Schedule); 0 turns it off
# PLUGIN_SOURCES_SYNC_S=86400
# The agent API's address as callers outside reach it: a scheduled task's API trigger is shown with
# it (http://localhost:17000 by default). Where it's published elsewhere, set it
# Over https, the API's responses also carry Strict-Transport-Security (headers.py)
# GEN9_API_PUBLIC_URL=https://gen9.example.com/api
# Notification emails about background runs (src/gen9_agent/notices.py): an SMTP server as a URL,
# smtp://[user:password@]host:port (STARTTLS when offered) or smtps://…; unset: no emails. make setup
# points it at Mailpit (smtp://gen9-mailpit:1025). Treat it as a secret when it holds a password
# SMTP_URL=smtp://gen9-mailpit:1025
# SMTP_FROM=Gen9 <gen9@gen9.local>
# How often one task, and one person's tasks, may fire outside their schedule in an hour
# TASKS_FIRES_PER_HOUR=30
# TASKS_FIRES_PER_PERSON_HOUR=100
# Clients registered by an admin at the sign-in servers of connectors that need sign-in, by the
# server's issuer; without one, Gen9 uses a Client ID Metadata Document (when GEN9_UI_URL is https)
# or registers itself (Dynamic Client Registration), in the MCP spec's order
# CONNECTORS_OAUTH_CLIENTS={"https://auth.example.com": {"client_id": "gen9", "client_secret": "…"}}
# The web app's address as people's browsers reach it (gen9-ui's APP_URL): sign-ins return there
# GEN9_UI_URL=http://localhost:14000
# The MCP registry the connector directory copies, hourly (src/gen9_agent/directory.py): the
# official one, or any registry with its v0.1 API, such as your organization's own. 0 turns the
# sync off
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# MCP_REGISTRY_SYNC_S=3600

# A chat's environment (gen9-sandbox): SANDBOX_URL and SANDBOX_API_KEY come from sandbox.local.env
# (make setup), which only the worker reads. Its image, share of the machine, idle time before it's
# removed, and the hosts it may reach (none by default):
# SANDBOX_IMAGE=python:3.12-slim@sha256:…
# SANDBOX_CPU=1
# SANDBOX_MEMORY=1Gi
# SANDBOX_IDLE_S=1800
# SANDBOX_COMMAND_TIMEOUT_S=600
# SANDBOX_EGRESS_ALLOW=["pypi.org", "files.pythonhosted.org"]

# Temporal's web UI, the only origin allowed to call the codec endpoint (/v1/temporal/codec); set it
# when the UI moves (gen9-temporal's GEN9_TEMPORAL_UI_PORT, or a deployment's https URL)
# TEMPORAL_UI_URL=http://localhost:18000

# Web search: "model", the model's own tool, OpenAI's, which needs `chat` on OpenAI; or "router",
# gen9-models' search alias `web` (self-hosted SearXNG by default), for any `chat` model. gen9-models
# serves `chat` from OpenRouter by default, so set router
WEB_SEARCH=router

# Rerank search results through gen9-models' `rerank` alias (its `local` profile serves a small one;
# a stronger or hosted reranker is set in its config.yaml). Off by default
# SEARCH_RERANK=false

# How often past chats are re-embedded after gen9-models' `embed` changes, and chats from before
# search backfilled (seconds; 0 turns the Schedule off), and the Postgres memory for building a
# model's vector index
# SEARCH_REINDEX_INTERVAL_S=900
# SEARCH_INDEX_MEMORY=1GB

# How long (seconds) a run waits for the person when the agent asks something mid-task, before it
# ends as expired; at least 60 (7 days by default; applies to runs started after a change)
# RUN_WAIT_S=604800
